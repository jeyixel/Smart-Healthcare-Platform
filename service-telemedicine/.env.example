# Copy this file to .env and fill your real values.
# This file is loaded by spring.config.import from application.properties.

DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?currentSchema=public&sslmode=require
DB_USER=postgres
DB_PASSWORD=replace-with-real-password

# Jitsi SaaS Configuration
jaas.app-id=your_vpaas_magic_cookie_here
jaas.api-key-id=your_key_id_here
# Note: In production, inject the private key via environment variables/K8s secrets
jaas.private-key=-----BEGIN PRIVATE KEY-----\nMIIE...your...key...\n-----END PRIVATE KEY-----